# Copie ce fichier en .env puis remplis-le.  (.env n'est jamais commité)
# Clé obtenue sur https://www.last.fm/api/account/create
LASTFM_API_KEY=ta_cle_api_ici
# Ton nom d'utilisateur Last.fm (affiché par défaut)
LASTFM_USER=ton_pseudo

# Optionnel
# PORT=3000                 # port exposé sur ta machine
# CACHE_TTL_SECONDS=60      # Last.fm est consulté au plus une fois par période
# MIN_PLAYS=3               # une tour par album écouté au moins 3 fois
# MAX_ALBUMS=1500           # sécurité : nombre maximum de tours dans la ville
# HISTORY_MAX_PAGES=1000    # limite de l'historique récupéré (pages de 200 écoutes)
